page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #222;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx;
}
.btn {
  background: #1677ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn[disabled] {
  opacity: 0.5;
}
.muted {
  color: #999;
  font-size: 24rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
