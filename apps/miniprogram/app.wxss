/* LiaoYu 治愈系绿 · 玻璃拟态设计系统 */

page {
  min-height: 100%;
  background:
    radial-gradient(60% 36% at 12% 0%, rgba(151, 216, 181, 0.5) 0%, rgba(151, 216, 181, 0) 100%),
    radial-gradient(52% 32% at 92% 6%, rgba(196, 233, 210, 0.65) 0%, rgba(196, 233, 210, 0) 100%),
    radial-gradient(70% 40% at 50% 108%, rgba(178, 226, 197, 0.55) 0%, rgba(178, 226, 197, 0) 100%),
    linear-gradient(180deg, #e8f3ec 0%, #eef6f0 40%, #f2f8f3 100%);
  background-attachment: fixed;
  font-size: 28rpx;
  color: #1f3b2c;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* 玻璃卡片 */
.glass {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(31, 59, 44, 0.08);
  padding: 30rpx;
  margin: 20rpx 24rpx;
}

/* 主按钮 */
.btn {
  background: linear-gradient(135deg, #3cb47c 0%, #1d7a52 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(29, 122, 82, 0.32);
  border: none;
}
.btn::after {
  border: none;
}
.btn[disabled] {
  opacity: 0.45;
}

/* 次级按钮（玻璃描边） */
.btn-ghost {
  background: rgba(255, 255, 255, 0.55);
  color: #1d7a52;
  border: 1rpx solid rgba(46, 158, 107, 0.4);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
}
.btn-ghost::after {
  border: none;
}

.muted {
  color: #6f8b7d;
  font-size: 24rpx;
  line-height: 1.6;
}
.empty {
  text-align: center;
  color: #8fa89b;
  font-size: 26rpx;
  padding: 72rpx 0;
}

/* 头像（首字圆形，4 种色调轮换） */
.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(31, 59, 44, 0.16);
}
.tone-0 {
  background: linear-gradient(135deg, #4cc08a, #1d7a52);
}
.tone-1 {
  background: linear-gradient(135deg, #56b8c2, #2b7f8c);
}
.tone-2 {
  background: linear-gradient(135deg, #e8b45e, #c98a2d);
}
.tone-3 {
  background: linear-gradient(135deg, #b3a7e0, #7a68b8);
}

/* 等级徽章 */
.level {
  font-size: 22rpx;
  font-weight: 600;
  color: #a06a12;
  background: linear-gradient(135deg, rgba(240, 200, 120, 0.4), rgba(240, 200, 120, 0.18));
  border: 1rpx solid rgba(201, 138, 45, 0.35);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

/* 方向标签 */
.tag {
  font-size: 22rpx;
  color: #1d7a52;
  background: rgba(60, 180, 124, 0.14);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-right: 12rpx;
}

/* 区块标题 */
.sec {
  display: flex;
  align-items: baseline;
  margin: 28rpx 32rpx 4rpx;
}
.sec-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.sec-sub {
  margin-left: 16rpx;
}
