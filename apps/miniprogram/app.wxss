/* LiaoYu 治愈系绿 · 设计系统
   色彩：主绿 #1d7a52 / 浅绿 #3cb47c；点缀 暖金 #c98a2d、警示 #c05a3c；文字 #1f3b2c / #6f8b7d / #8fa89b */

page {
  --green: #1d7a52;
  --green-2: #3cb47c;
  --gold: #c98a2d;
  --red: #c05a3c;
  --blue: #2b7f8c;
  --text: #1f3b2c;
  --sub: #6f8b7d;
  --hint: #8fa89b;
  --line: rgba(31, 59, 44, 0.08);
  --card: rgba(255, 255, 255, 0.72);

  min-height: 100%;
  background:
    radial-gradient(60% 36% at 12% 0%, rgba(151, 216, 181, 0.5) 0%, rgba(151, 216, 181, 0) 100%),
    radial-gradient(52% 32% at 92% 6%, rgba(196, 233, 210, 0.65) 0%, rgba(196, 233, 210, 0) 100%),
    radial-gradient(70% 40% at 50% 108%, rgba(178, 226, 197, 0.55) 0%, rgba(178, 226, 197, 0) 100%),
    linear-gradient(180deg, #e8f3ec 0%, #eef6f0 40%, #f2f8f3 100%);
  background-attachment: fixed;
  font-size: 28rpx;
  color: var(--text);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  line-height: 1.5;
}

/* 页面底部留白（配合 .bar 固定操作栏 / 安全区） */
.pb {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.pb-sm {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.glass {
  background: var(--card);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(31, 59, 44, 0.07);
  padding: 30rpx;
  margin: 20rpx 24rpx;
}
.glass.flush {
  padding: 0;
  overflow: hidden;
}

/* ---------- 页头 ---------- */
.hero {
  padding: 36rpx 40rpx 12rpx;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--sub);
}

/* 区块标题 */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 40rpx 4rpx;
}
.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.sec-sub {
  margin-left: 16rpx;
}
.sec-more {
  font-size: 24rpx;
  color: var(--green);
}

/* ---------- 文本 ---------- */
.muted {
  color: var(--sub);
  font-size: 24rpx;
  line-height: 1.6;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
}
.strong {
  font-weight: 700;
}
.price {
  color: #b9752e;
  font-weight: 700;
  font-size: 34rpx;
}
.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row {
  display: flex;
  align-items: center;
}
.grow {
  flex: 1;
  min-width: 0;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---------- 按钮 ---------- */
.btn {
  background: linear-gradient(135deg, var(--green-2) 0%, var(--green) 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(29, 122, 82, 0.3);
  border: none;
  line-height: 1.4;
}
.btn::after,
.btn-ghost::after,
.btn-sm::after {
  border: none;
}
.btn[disabled] {
  opacity: 0.45;
}
.btn-ghost {
  background: rgba(255, 255, 255, 0.6);
  color: var(--green);
  border: 1rpx solid rgba(46, 158, 107, 0.4);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  line-height: 1.4;
}
.btn-ghost[disabled] {
  opacity: 0.45;
}
/* 小按钮：行内操作 */
.btn-sm {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(46, 158, 107, 0.45);
  color: var(--green);
  background: rgba(255, 255, 255, 0.7);
  margin: 0 0 0 16rpx;
}
.btn-sm.primary {
  background: linear-gradient(135deg, var(--green-2), var(--green));
  color: #fff;
  border-color: transparent;
}
.btn-sm.danger {
  color: var(--red);
  border-color: rgba(192, 90, 60, 0.45);
}
.btn-sm[disabled] {
  opacity: 0.45;
}
.retry {
  width: 240rpx;
  margin: 24rpx auto 0;
}

/* 底部固定操作栏 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(247, 251, 248, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--line);
  z-index: 10;
}

/* ---------- 头像 / 标签 ---------- */
.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(31, 59, 44, 0.16);
}
.avatar.big {
  width: 128rpx;
  height: 128rpx;
  font-size: 56rpx;
}
.avatar.sm {
  width: 72rpx;
  height: 72rpx;
  font-size: 30rpx;
}
.tone-0 {
  background: linear-gradient(135deg, #4cc08a, #1d7a52);
}
.tone-1 {
  background: linear-gradient(135deg, #56b8c2, #2b7f8c);
}
.tone-2 {
  background: linear-gradient(135deg, #e8b45e, #c98a2d);
}
.tone-3 {
  background: linear-gradient(135deg, #b3a7e0, #7a68b8);
}

.level {
  font-size: 22rpx;
  font-weight: 600;
  color: #a06a12;
  background: linear-gradient(135deg, rgba(240, 200, 120, 0.4), rgba(240, 200, 120, 0.18));
  border: 1rpx solid rgba(201, 138, 45, 0.35);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  margin-left: 12rpx;
}
.tag {
  font-size: 22rpx;
  color: var(--green);
  background: rgba(60, 180, 124, 0.14);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin-right: 12rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 0;
}

/* 状态标签 */
.pill {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.pill-green {
  color: var(--green);
  background: rgba(60, 180, 124, 0.16);
}
.pill-gold {
  color: #a06a12;
  background: rgba(240, 200, 120, 0.3);
}
.pill-red {
  color: var(--red);
  background: rgba(192, 90, 60, 0.14);
}
.pill-blue {
  color: var(--blue);
  background: rgba(86, 184, 194, 0.2);
}
.pill-gray {
  color: var(--sub);
  background: rgba(111, 139, 125, 0.14);
}

/* 红点 / 数字角标 */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--red);
  flex-shrink: 0;
}

/* ---------- 列表行 ---------- */
.cell {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--line);
}
.cell:last-child {
  border-bottom: none;
}
.cell-hover {
  background: rgba(60, 180, 124, 0.08);
}
.cell-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.cell-arrow {
  color: var(--hint);
  font-size: 32rpx;
  margin-left: 12rpx;
}
.cell-val {
  color: var(--sub);
  font-size: 26rpx;
}

/* ---------- 提醒横幅 ---------- */
.banner {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 26rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(240, 200, 120, 0.42), rgba(240, 200, 120, 0.2));
  border: 1rpx solid rgba(201, 138, 45, 0.3);
  color: #7a4f0e;
}
.banner.info {
  background: linear-gradient(135deg, rgba(86, 184, 194, 0.3), rgba(86, 184, 194, 0.12));
  border-color: rgba(43, 127, 140, 0.3);
  color: #1d5f6a;
}
.banner-body {
  flex: 1;
  min-width: 0;
}
.banner-title {
  font-weight: 700;
  font-size: 28rpx;
}
.banner-sub {
  font-size: 24rpx;
  opacity: 0.85;
}

/* ---------- 数据格 ---------- */
.stats {
  display: flex;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-v {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--green);
}
.stat-k {
  font-size: 22rpx;
  color: var(--sub);
}

/* 进度条 */
.progress {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(31, 59, 44, 0.08);
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--green-2), var(--green));
}

/* ---------- 表单 ---------- */
.field {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--line);
}
.field:last-child {
  border-bottom: none;
}
.field-label {
  font-size: 24rpx;
  color: var(--sub);
  margin-bottom: 10rpx;
}
.input {
  font-size: 30rpx;
  height: 56rpx;
  min-height: 56rpx;
}
.textarea {
  width: 100%;
  font-size: 28rpx;
  height: 180rpx;
  line-height: 1.6;
}
.input-ph {
  color: #b5c9be;
}

/* 选择芯片 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  font-size: 26rpx;
  color: var(--sub);
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(31, 59, 44, 0.1);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}
.chip-on {
  color: #fff;
  background: linear-gradient(135deg, var(--green-2), var(--green));
  border-color: transparent;
  font-weight: 600;
}
.chip-off {
  opacity: 0.4;
}

/* ---------- 状态页 ---------- */
.empty {
  text-align: center;
  color: var(--hint);
  font-size: 26rpx;
  padding: 72rpx 0;
}
.empty-card {
  text-align: center;
  color: var(--hint);
  font-size: 26rpx;
  padding: 56rpx 0;
}

/* 骨架屏 */
.sk {
  border-radius: 16rpx;
  background: linear-gradient(90deg, rgba(31, 59, 44, 0.06) 25%, rgba(31, 59, 44, 0.12) 50%, rgba(31, 59, 44, 0.06) 75%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
}
@keyframes sk {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}
.sk-line {
  height: 28rpx;
  margin: 14rpx 0;
}
.sk-line.short {
  width: 40%;
}
.sk-line.mid {
  width: 65%;
}
