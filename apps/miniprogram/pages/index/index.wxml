<view wx:if="{{loading}}">
  <view class="empty">正在为你准备…</view>
</view>

<!-- 学员：老师列表 -->
<block wx:elif="{{role === 'student'}}">
  <view class="hero">
    <view class="hero-title">今天，想聊聊什么？</view>
    <view class="hero-sub">每一位老师，都在这里陪你</view>
  </view>

  <view class="filter" wx:if="{{directions.length}}">
    <view
      wx:for="{{directions}}"
      wx:key="*this"
      class="chip {{direction === item ? 'chip-on' : ''}}"
      data-d="{{item}}"
      bindtap="onTapDirection"
    >{{item}}</view>
  </view>

  <view class="glass teacher" wx:for="{{teachers}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapTeacher">
    <view class="avatar tone-{{item.tone}}">{{item.initial}}</view>
    <view class="body">
      <view class="line">
        <text class="name">{{item.displayName}}</text>
        <text class="level">Lv{{item.level}}</text>
      </view>
      <view class="muted intro">{{item.intro}}</view>
      <view class="line bottom">
        <view class="tags">
          <text class="tag" wx:for="{{item.directions}}" wx:for-item="d" wx:key="*this">{{d}}</text>
        </view>
        <text class="price" wx:if="{{item.minPriceCents}}">¥{{item.yuan}}<text class="price-unit"> 起</text></text>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!teachers.length}}">老师们正在路上，稍等片刻</view>
</block>

<!-- 老师：今日概览 -->
<block wx:else>
  <view class="hero">
    <view class="hero-title">今日概览</view>
    <view class="hero-sub">{{todayLabel}} · 共 {{appointments.length}} 条预约</view>
  </view>
  <view class="glass appt" wx:for="{{appointments}}" wx:key="id">
    <view class="avatar tone-{{index % 4}}">{{item.initial}}</view>
    <view class="appt-body">
      <view class="line">
        <text class="name">{{item.userNickname || '学员'}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="muted">{{item.date}} · {{item.hm}}</view>
    </view>
  </view>
  <view class="empty" wx:if="{{!appointments.length}}">今天还没有预约，安心休息</view>
</block>
