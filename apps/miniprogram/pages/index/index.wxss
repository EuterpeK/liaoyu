.filter {
  white-space: nowrap;
  display: flex;
  padding: 16rpx 24rpx 4rpx;
}
.filter .chip {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.teacher {
  display: flex;
  align-items: flex-start;
}
.teacher .body {
  margin-left: 24rpx;
}
.teacher .intro {
  margin: 8rpx 0 12rpx;
  min-height: 80rpx;
}
.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--sub);
}

.grid {
  display: flex;
  padding: 28rpx 12rpx;
}
.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: var(--text);
}
.entry-ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 59, 44, 0.16);
}
