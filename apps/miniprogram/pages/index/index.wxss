.hero {
  padding: 44rpx 36rpx 8rpx;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 10rpx;
  color: #6f8b7d;
  font-size: 26rpx;
}
.filter {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 32rpx 0;
}
.chip {
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(46, 158, 107, 0.25);
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 24rpx;
  color: #4a6b5a;
}
.chip-on {
  background: linear-gradient(135deg, #3cb47c, #1d7a52);
  border-color: transparent;
  color: #fff;
}
.teacher {
  display: flex;
}
.teacher .body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.name {
  font-size: 32rpx;
  font-weight: 700;
}
.intro {
  margin: 8rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.bottom {
  justify-content: space-between;
}
.tags {
  display: flex;
  flex-wrap: wrap;
}
.price {
  color: #d38b3c;
  font-weight: 700;
  font-size: 34rpx;
}
.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #b99c72;
}
.appt {
  display: flex;
  align-items: center;
}
.appt-body {
  flex: 1;
  margin-left: 24rpx;
}
.status {
  color: #6f8b7d;
  font-size: 24rpx;
}
