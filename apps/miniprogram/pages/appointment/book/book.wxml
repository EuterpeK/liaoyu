<view class="glass">
  <view class="who">
    <text class="pre">与</text>
    <text class="name">{{name}}</text>
    <text class="pre">的约定</text>
  </view>
  <view class="days">
    <view
      wx:for="{{days}}"
      wx:key="date"
      class="day {{date === item.date ? 'day-on' : ''}}"
      data-d="{{item.date}}"
      bindtap="onTapDay"
    >
      <view class="day-label">{{item.label}}</view>
    </view>
  </view>
</view>
<view class="glass">
  <view class="sec-title in-card">可约时段 · {{date}}</view>
  <view class="slots">
    <view
      wx:for="{{slots}}"
      wx:key="*this"
      class="slot {{chosen === item ? 'slot-on' : ''}}"
      data-s="{{item}}"
      bindtap="onTapSlot"
    >{{item}}</view>
  </view>
  <view class="empty" wx:if="{{!slots.length}}">这一天老师暂无可约时段</view>
</view>
<view class="pay-wrap">
  <button class="btn" disabled="{{!chosen || booking}}" bindtap="onTapBook">
    {{booking ? '正在预约…' : chosen ? '预约 ' + date + ' ' + chosen : '先挑一个时段吧'}}
  </button>
</view>
