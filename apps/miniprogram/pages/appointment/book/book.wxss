.days {
  white-space: nowrap;
  display: flex;
  padding: 16rpx 24rpx 4rpx;
}
.day {
  flex-shrink: 0;
  margin-right: 14rpx;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(31, 59, 44, 0.08);
  font-size: 26rpx;
}
.day-on {
  background: linear-gradient(135deg, var(--green-2), var(--green));
  border-color: transparent;
  color: #fff;
  font-weight: 600;
}
.slots {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.slot,
.slot-sk {
  width: calc((100% - 54rpx) / 4);
  box-sizing: border-box;
}
.slot {
  text-align: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background: rgba(60, 180, 124, 0.1);
  border: 1rpx solid rgba(60, 180, 124, 0.25);
  color: var(--green);
  font-weight: 600;
}
.slot-on {
  background: linear-gradient(135deg, var(--green-2), var(--green));
  border-color: transparent;
  color: #fff;
}
.slot-sk {
  height: 76rpx;
  border-radius: 20rpx;
}
.retry-sm {
  margin: 20rpx auto 0;
}
