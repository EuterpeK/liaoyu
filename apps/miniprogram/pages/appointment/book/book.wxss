.who {
  display: flex;
  align-items: baseline;
}
.pre {
  color: #6f8b7d;
  font-size: 28rpx;
  margin: 0 10rpx;
}
.name {
  font-size: 40rpx;
  font-weight: 700;
}
.days {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.day {
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(46, 158, 107, 0.25);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
}
.day-label {
  font-size: 24rpx;
  color: #4a6b5a;
}
.day-on {
  background: linear-gradient(135deg, #3cb47c, #1d7a52);
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(29, 122, 82, 0.28);
}
.day-on .day-label {
  color: #fff;
  font-weight: 600;
}
.sec-title.in-card {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.slots {
  display: flex;
  flex-wrap: wrap;
}
.slot {
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(46, 158, 107, 0.25);
  border-radius: 18rpx;
  padding: 18rpx 34rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 28rpx;
  color: #2c4a3a;
}
.slot-on {
  background: linear-gradient(135deg, #3cb47c, #1d7a52);
  border-color: transparent;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(29, 122, 82, 0.28);
}
.pay-wrap {
  margin: 40rpx 48rpx 0;
}
