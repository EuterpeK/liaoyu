.days {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.day {
  background: #f5f6f8;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 24rpx;
  color: #666;
}
.day-on {
  background: #1677ff;
  color: #fff;
}
.slots {
  display: flex;
  flex-wrap: wrap;
}
.slot {
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 16rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
}
.slot-on {
  background: #1677ff;
  color: #fff;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.name {
  font-size: 32rpx;
  font-weight: 600;
}
