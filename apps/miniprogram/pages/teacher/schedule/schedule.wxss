.days {
  white-space: nowrap;
  display: flex;
  padding: 16rpx 24rpx 4rpx;
}
.day {
  flex-shrink: 0;
  width: 116rpx;
  margin-right: 14rpx;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(31, 59, 44, 0.08);
  display: flex;
  flex-direction: column;
}
.day-label {
  font-size: 28rpx;
  font-weight: 600;
}
.day-count {
  font-size: 20rpx;
  color: var(--hint);
  margin-top: 4rpx;
}
.day-count.has {
  color: var(--green);
}
.day-on {
  background: linear-gradient(135deg, var(--green-2), var(--green));
  border-color: transparent;
  color: #fff;
}
.day-on .day-count,
.day-on .day-count.has {
  color: rgba(255, 255, 255, 0.85);
}

.add {
  display: flex;
  align-items: center;
}
.time-box {
  display: flex;
  flex-direction: column;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(60, 180, 124, 0.1);
}
.time {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--green);
}
.to {
  margin: 0 16rpx;
  color: var(--sub);
}
.add-btn {
  margin-left: auto;
  padding: 20rpx 36rpx;
}
.copy {
  margin: 28rpx 40rpx;
  font-size: 26rpx;
  color: var(--green);
}
