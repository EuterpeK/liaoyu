.profile {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}
.who {
  font-size: 42rpx;
  font-weight: 700;
}
.intro {
  font-size: 27rpx;
  line-height: 1.8;
  color: #3d5a4b;
  white-space: pre-wrap;
}
.pkg-title {
  font-size: 32rpx;
  font-weight: 700;
}
.big-price {
  font-size: 40rpx;
}
.feats {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 8rpx;
}
.feat {
  font-size: 22rpx;
  color: #4a6b5a;
  background: rgba(60, 180, 124, 0.12);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
}
.pkg-btn {
  margin-top: 12rpx;
}
