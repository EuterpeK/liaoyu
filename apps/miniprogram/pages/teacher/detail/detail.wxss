.hero {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}
.avatar.big {
  width: 128rpx;
  height: 128rpx;
  font-size: 56rpx;
}
.hero-body {
  margin-left: 28rpx;
  flex: 1;
}
.line {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.name {
  font-size: 40rpx;
  font-weight: 700;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.intro {
  font-size: 26rpx;
  line-height: 1.8;
}
.pkg-title {
  font-size: 32rpx;
  font-weight: 700;
}
.price {
  color: #d38b3c;
  font-weight: 700;
  font-size: 38rpx;
}
.feats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.feat {
  font-size: 22rpx;
  color: #4a6b5a;
  background: rgba(60, 180, 124, 0.12);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
}
.pkg-btn {
  margin-top: 10rpx;
}
