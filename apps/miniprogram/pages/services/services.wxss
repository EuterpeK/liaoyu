.hero {
  padding: 44rpx 36rpx 8rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 10rpx;
  color: #6f8b7d;
  font-size: 26rpx;
}
.sec-title.in-card {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.rel {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(31, 59, 44, 0.06);
}
.rel:last-child {
  border-bottom: none;
}
.rel-body {
  flex: 1;
  margin-left: 22rpx;
}
.appt {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(31, 59, 44, 0.06);
}
.appt:last-child {
  border-bottom: none;
}
.appt-body {
  flex: 1;
  margin-left: 22rpx;
}
.line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
}
.link,
.cancel {
  color: #1d7a52;
  font-size: 26rpx;
  font-weight: 500;
}
