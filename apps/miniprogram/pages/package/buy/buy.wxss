.title {
  font-size: 34rpx;
  font-weight: 700;
}
.big {
  font-size: 44rpx;
}
.notes {
  padding: 12rpx 30rpx;
}
.note {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #3d5a4b;
}
.dot-g {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--green-2);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.bar {
  display: flex;
  align-items: center;
}
.total {
  display: flex;
  flex-direction: column;
  margin-right: 32rpx;
}
.pay-btn {
  flex: 1;
}
