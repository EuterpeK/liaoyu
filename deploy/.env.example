# 复制为 deploy/.env 后填写；该文件不入库
# 已备案域名，DNS 指向本机
DOMAIN=api.example.com
# openssl rand -hex 24（只用十六进制，避免破坏 DATABASE_URL）
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -base64 32；丢失后实名数据无法解密，务必离线备份
FIELD_KEY=
ZPAY_PID=
ZPAY_KEY=
WX_APPID=
WX_APPSECRET=
# 腾讯云 IM / TRTC：控制台获取 SDKAppID 与密钥；两个回调凭证自行生成并填到控制台回调配置
TENCENT_SDKAPPID=
TENCENT_SECRETKEY=
# openssl rand -hex 16
IM_CALLBACK_TOKEN=
# openssl rand -hex 16
TRTC_CALLBACK_KEY=
# 危机提示展示的求助热线（可选）
CRISIS_HOTLINE=12356
# backup.sh 使用，例如 liaoyu-backup-1250000000
COS_BUCKET=
